# EXAMPLE ONLY. This file grants nothing and contains no secret.
#
# Copy it to an operator-owned path outside every managed project root, then
# set the real absolute paths, App id, and installation id. Mode 0600, owned
# by the F008 service user. Do not commit the copy.
#
# Point the F008 process at it with VEDAOPS_GITHUB_POLICY.
# The principal is VEDAOPS_GITHUB_PRINCIPAL, not VEDAOPS_AGENT_ID.
# Shadow's VEDAOPS_PROJECTS_REGISTRY is not read.

schema_version = 1
enabled = false

[provider]
release = "v1.12.2"
commit = "85598ba6e1256f7ebf4867b95d63b833c4549264"
artifact = "github-mcp-server_Linux_x86_64.tar.gz"
artifact_sha256 = "95843162759da2c31dde082dd145be35db82164594796c294414b69790c2290e"
api_version = "2022-11-28"
feature = "pull_requests_granular"
app_id = "000000"
installation_id = "000000"
# binary_path = "/var/lib/vedaops-github/bin/github-mcp-server"
# private_key_path = "/var/lib/vedaops-github/secrets/app.pem"
# provider_login = "example-app[bot]"

[journal]
directory = "/var/lib/vedaops-github/operations"

[[projects]]
id = "example-project"
root = "/var/lib/vedaops-github/example-roots/example-project"
github_owner = "example-org"
github_repo = "example-repo"

[[principals]]
id = "example-steward"

[[principals.grants]]
project = "example-project"
operations = [
  "read",
  "pr_create",
  "pr_update_title",
  "pr_update_body",
  "pr_comment",
  "pr_request_reviewers",
]
